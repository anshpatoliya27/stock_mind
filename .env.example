# StockMind AI Configuration
# Copy this file to .env and configure your preferred provider

# LLM Provider: 'gemini' (Google), 'grok' (xAI), or 'openai'
LLM_PROVIDER=gemini

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=

# xAI Grok API Key (Get key from https://console.x.ai/)
GROK_API_KEY=
# Alternatively: XAI_API_KEY=

# OpenAI API Key (If using OpenAI provider)
OPENAI_API_KEY=

# Default Model Selection
# For Gemini: gemini-3.5-flash (fast, multimodal) or gemini-flash-lite-latest
# For Grok: grok-2-vision-1212 (multimodal chart vision) or grok-2
# For OpenAI: gpt-4o-mini or gpt-4o
LLM_MODEL=gemini-3.5-flash

# Application Server Host & Port
HOST=127.0.0.1
PORT=8000

# Path to local datasets (relative to project root or absolute)
DATASET_PATH=Dataset
